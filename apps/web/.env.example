# ---------------------------------------------------------------------------
# Ranklark works with NO keys (public Apple data). Each block below unlocks more.
# Copy to .env.local and restart `pnpm dev`.
# ---------------------------------------------------------------------------

# --- App Store Connect API (your real subtitle + hidden keyword field, all locales)
# App Store Connect › Users and Access › Integrations › App Store Connect API › Team Keys (Admin creates; role: App Manager or Admin)
ASC_ISSUER_ID=
ASC_KEY_ID=
# path to the downloaded AuthKey_XXXXXX.p8 (or paste the PEM into ASC_PRIVATE_KEY with \n escapes)
ASC_PRIVATE_KEY_PATH=
# ASC_PRIVATE_KEY=

# --- Apple Ads Platform API 1.0 (real Apple popularity 0–100 for any phrase)
# Generate a key: openssl ecparam -genkey -name prime256v1 -noout -out ads-private.pem
#                 openssl ec -in ads-private.pem -pubout -out ads-public.pem
# Upload ads-public.pem in Apple Ads › Account Settings › API, then copy the IDs shown there.
# Use an "API Account Read Only" user.
ADS_CLIENT_ID=
ADS_TEAM_ID=
ADS_KEY_ID=
ADS_AD_ACCOUNT_ID=
ADS_PRIVATE_KEY_PATH=
# ADS_PRIVATE_KEY=

# --- AI research (bring your own Claude). Optional.
# Normally each browser saves its own key in Settings (kept in that browser, sent per run, never stored here).
# A server key is used only in ASO_FETCH_MODE=server (single-user self-hosting), so a shared server can't
# spend your key on other people's runs. Get one at platform.claude.com.
# ANTHROPIC_API_KEY=
# Scripted test model for development and e2e tests: no Claude calls, real Apple data, labelled "scripted-test".
# `next start` also needs RANKLARK_AGENT_SCRIPTED_ALLOW_PRODUCTION=1. Never set these on a real deployment.
# RANKLARK_AGENT_SCRIPTED=1

# --- Behaviour
# 0 = only use the official iTunes Search API for ranks (no apps.apple.com page reads)
ASO_WEB_SEARCH=1
# request spacing (ms) per host
ITUNES_GAP_MS=3200
WEB_GAP_MS=2500
HINTS_GAP_MS=1200

# --- Who talks to Apple
# server (default): this process calls Apple — fine for one self-hosted user
# extension: the server NEVER calls Apple; each user's browser extension does the checks
ASO_FETCH_MODE=server

# --- Storage
# SQLite file (default: apps/web/data/aso.db)
# ASO_DB_PATH=data/aso.db
# Word list for brand-term detection (default: /usr/share/dict/words; missing → that rule is skipped)
# ASO_WORDLIST=/usr/share/dict/words

# --- Extension
# Pin which extension IDs may connect without a login (comma-separated). Empty = any chrome-extension:// origin.
# EXT_ALLOWED_IDS=
# ID of your published (Web Store) build, so the dashboard can message it. Defaults to the dev build's fixed ID.
# NEXT_PUBLIC_EXTENSION_ID=
# Chrome Web Store listing, shown as an "Add to Chrome" button on the Extension page.
# NEXT_PUBLIC_EXTENSION_STORE_URL=
